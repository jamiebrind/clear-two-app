# Optional example. Set this only if you already know your speaker’s IP.
# CLEAR_TWO_SPEAKER_IP=192.168.1.100
CLEAR_TWO_HOST=127.0.0.1
CLEAR_TWO_PORT=4273
# Optional HTTPS listener for browser microphone access. Use a certificate trusted by the phone and valid for CLEAR_TWO_HOST.
# CLEAR_TWO_HTTPS_PORT=4274
# CLEAR_TWO_TLS_KEY=C:/path/outside-the-repo/bridge-key.pem
# CLEAR_TWO_TLS_CERT=C:/path/outside-the-repo/bridge-cert.pem
